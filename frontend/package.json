{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "lint": "eslint",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:staging": "node scripts/run-e2e.mjs e2e/staging-smoke.spec.ts --project=chromium",
    "e2e:headed": "node scripts/run-e2e.mjs --headed",
    "e2e:ui": "node scripts/run-e2e.mjs --ui",
    "e2e:report": "playwright show-report",
    "security:check": "node ../scripts/audit-production-dependencies.js frontend",
    "e2e:menus": "node scripts/run-core-e2e.mjs menus",
    "e2e:flows": "node scripts/run-core-e2e.mjs flows"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "read-excel-file": "^9.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
  }
}
