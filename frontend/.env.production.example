# MANITEC GridOne Frontend - exemplo de producao
# Mesmo servidor: o navegador usa /api e o Next encaminha internamente para a API.
INTERNAL_API_URL="http://127.0.0.1:3000"

# Use NEXT_PUBLIC_API_URL somente quando a API tiver outro endereco publico.
# Variaveis NEXT_PUBLIC_* ficam expostas ao navegador e sao incorporadas no build.
# NEXT_PUBLIC_API_URL="https://api.suaempresa.com.br"

# E2E contra staging/piloto, se aplicavel
E2E_API_URL="https://api-staging.suaempresa.com.br"
E2E_BASE_URL="https://erp-staging.suaempresa.com.br"
E2E_DEMO_PASSWORD="REPLACE_ONLY_IN_STAGING_SECRET_MANAGER"
E2E_TOTP_SECRET="REPLACE_ONLY_IN_STAGING_SECRET_MANAGER"
E2E_RUNNER_TIMEOUT_MS="2700000"
E2E_PLAYWRIGHT_GLOBAL_TIMEOUT_MS="2670000"
E2E_SERVER_TIMEOUT_MS="180000"
E2E_MAX_FAILURES="1"
E2E_VERBOSE_SERVER="0"
