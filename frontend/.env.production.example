# Frontend: o navegador usa /api, com encaminhamento interno para a API.
INTERNAL_API_URL="http://127.0.0.1:3000"
# Valor vazio impede que um .env.local de desenvolvimento force uma API local.
NEXT_PUBLIC_API_URL=""
# NEXT_PUBLIC_* sao publicas e incorporadas ao build. Nunca inclua segredos.
# Use somente se a API possuir endereco publico independente:
# NEXT_PUBLIC_API_URL="https://api.suaempresa.com.br"
# Origem do Portal do Cliente se houver dominio separado:
# NEXT_PUBLIC_PORTAL_BASE_URL="https://portal.suaempresa.com.br"

# Credenciais E2E pertencem exclusivamente ao ambiente isolado de testes.
# Nao configure E2E_DEMO_PASSWORD ou E2E_TOTP_SECRET em producao.
