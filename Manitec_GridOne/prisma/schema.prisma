generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. ENUMS (Definições globais) ---

enum UserRole {
  ADMIN
  TECHNICIAN
  SALES
  CLIENT
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

// --- 2. MODELOS ---

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(TECHNICIAN)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  technicianProfile Technician? 

  @@map("users")
}

model Technician {
  id        String   @id @default(uuid())
  cpf       String   @unique
  phone     String
  skills    String[]
  
  latitude  Float?
  longitude Float?

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  // Relação com O.S.
  orders    MaintenanceOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("technicians")
}

model Client {
  id            String   @id @default(uuid())
  companyName   String
  cnpj          String   @unique
  contactName   String?
  phone         String
  address       String?
  city          String
  state         String

  generators    Generator[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("clients")
}

model Generator {
  id            String   @id @default(uuid())
  name          String
  brand         String
  model         String
  serialNumber  String   @unique
  power         Float
  
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])

  // Relação com O.S.
  orders        MaintenanceOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("generators")
}

model MaintenanceOrder {
  id            String       @id @default(uuid())
  title         String
  description   String?
  
  // Integração Auvo
  auvoId        String?
  auvoLink      String?
  
  status        OrderStatus  @default(OPEN)
  priority      String       @default("NORMAL")

  openedAt      DateTime     @default(now())
  closedAt      DateTime?

  // Relações
  generatorId   String
  generator     Generator    @relation(fields: [generatorId], references: [id])

  technicianId  String
  technician    Technician   @relation(fields: [technicianId], references: [id])

  updatedAt     DateTime     @updatedAt

  @@map("maintenance_orders")
}