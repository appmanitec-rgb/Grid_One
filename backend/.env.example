# MANITEC GridOne API - desenvolvimento/local
NODE_ENV="development"
PORT="3000"

# Banco de dados
DATABASE_URL="postgresql://postgres:postgrespw@localhost:5433/gridone_db?schema=public"
DB_NAME="gridone_db"
EXPECTED_DB_NAME="gridone_db"

# Auth/sessao
JWT_SECRET="change_me_local_only"
MFA_ISSUER="Manitec GridOne"
MFA_ENCRYPTION_KEY=""

# CORS/rate limit
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"

# URLs publicas usadas em documentos, links e E2E
APP_BASE_URL="http://localhost:3001"
FRONTEND_BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3001"

# Storage documental
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_PATH="./storage/private"
# Para S3/MinIO/Supabase, troque FILE_STORAGE_DRIVER para s3|minio|supabase e configure:
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Seed demo/dev
SEED_ADMIN_EMAIL="admin@manitec.local"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="change_admin_password"
SEED_MASTER_EMAIL="master@manitec.local"
SEED_MASTER_NAME="MANITEC"
SEED_MASTER_PASSWORD="change_master_password"
SEED_DEMO_PASSWORD="Demo@123456"

# Automacoes
AUTOMATION_ENABLED="true"
AUTOMATION_RUN_ON_BOOT="false"
AUTOMATION_TIMEZONE="America/Sao_Paulo"
AUTOMATION_DAILY_CRON="0 5 * * *"
AUTOMATION_HOURLY_ENABLED="true"
AUTOMATION_HOURLY_CRON="15 * * * *"
AUTOMATION_PREVENTIVE_DAYS_AHEAD="45"

# Entregas/e-mail/WhatsApp opcionais
DELIVERY_FROM_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v20.0"
DELIVERY_WEBHOOK_SECRET=""

# E2E local
E2E_DEMO_PASSWORD="Demo@123456"
E2E_TOTP_SECRET="JBSWY3DPEHPK3PXP"
E2E_API_URL="http://127.0.0.1:3000"
E2E_BASE_URL="http://127.0.0.1:3001"
E2E_RUNNER_TIMEOUT_MS="2700000"
E2E_SERVER_TIMEOUT_MS="180000"
E2E_THROTTLE_LIMIT="10000"
