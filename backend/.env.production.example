# MANITEC GridOne API - producao. Nunca commite credenciais reais.
NODE_ENV="production"
PORT="3000"
# API acessivel somente pelo proxy do frontend/reverse proxy.
API_HOST="127.0.0.1"
API_TRUST_PROXY="loopback"

# PostgreSQL; DB_NAME e EXPECTED_DB_NAME devem coincidir com DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/DB_NAME?schema=public"
DB_NAME="DB_NAME"
EXPECTED_DB_NAME="DB_NAME"
# Docker local, caso utilizado:
# DB_USER="gridone"
# DB_PASS="REPLACE_WITH_RANDOM_DATABASE_PASSWORD"
DB_BIND_ADDRESS="127.0.0.1"

# Gere um segredo aleatorio com pelo menos 32 caracteres.
JWT_SECRET="REPLACE_WITH_64_PLUS_RANDOM_CHARS"
MFA_ISSUER="MANITEC Operacao Integrada"
# Opcional: chave independente para MFA. Preserve a chave apos habilitar MFA.
# MFA_ENCRYPTION_KEY="REPLACE_WITH_64_PLUS_RANDOM_CHARS"

CORS_ORIGINS="https://erp.suaempresa.com.br"
APP_BASE_URL="https://erp.suaempresa.com.br"
FRONTEND_BASE_URL="https://erp.suaempresa.com.br"
FRONTEND_URL="https://erp.suaempresa.com.br"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="300"

# Armazenamento local permanente. Ajuste o caminho absoluto ao servidor.
# Windows: C:/ManitecData/documentos ; Linux: /var/lib/manitec/documentos
# Inclua esta pasta no backup; mantenha-a fora de frontend/public.
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_PATH="C:/ManitecData/documentos"
# Armazenamento externo opcional (nao necessario para operar):
# FILE_STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://s3.REGIAO.amazonaws.com"
# S3_BUCKET="manitec-documentos"
# S3_REGION="sa-east-1"
# S3_ACCESS_KEY_ID="REPLACE_IN_SECRET_MANAGER"
# S3_SECRET_ACCESS_KEY="REPLACE_IN_SECRET_MANAGER"
# S3_FORCE_PATH_STYLE="false"

# PDF: no Windows usa a instalacao padrao do LibreOffice.
# Linux: LIBREOFFICE_BIN="/usr/bin/libreoffice"
# LIBREOFFICE_BIN="C:/Program Files/LibreOffice/program/soffice.exe"
LIBREOFFICE_TIMEOUT_MS="60000"

# Primeiro administrador: somente se executar seed em uma base nova.
# Nao execute seed de demonstracao em producao.
# SEED_ADMIN_EMAIL="admin@empresa.com.br"
# SEED_ADMIN_NAME="Administrador"
# SEED_ADMIN_PASSWORD="REPLACE_BEFORE_RUNNING_SEED"
# SEED_MASTER_EMAIL="master@empresa.com.br"
# SEED_MASTER_NAME="MANITEC"
# SEED_MASTER_PASSWORD="REPLACE_BEFORE_RUNNING_SEED"

AUTOMATION_ENABLED="true"
AUTOMATION_RUN_ON_BOOT="false"
AUTOMATION_TIMEZONE="America/Sao_Paulo"
AUTOMATION_DAILY_CRON="0 5 * * *"
AUTOMATION_HOURLY_ENABLED="true"
AUTOMATION_HOURLY_CRON="15 * * * *"
AUTOMATION_PREVENTIVE_DAYS_AHEAD="45"

# E-mail/WhatsApp opcionais. Deixe sem configurar se nao forem utilizados.
# true mantém links/downloads disponíveis, sem transmitir a serviços externos.
# EXTERNAL_DELIVERIES_DISABLED="true"
# RESEND_API_KEY="REPLACE_IN_SECRET_MANAGER"
# RESEND_FROM_EMAIL="noreply@suaempresa.com.br"
# WHATSAPP_ACCESS_TOKEN="REPLACE_IN_SECRET_MANAGER"
# WHATSAPP_PHONE_NUMBER_ID="REPLACE_IN_SECRET_MANAGER"
# DELIVERY_WEBHOOK_SECRET="REPLACE_WITH_RANDOM_SECRET"

ALLOW_DB_RESTORE="no"
