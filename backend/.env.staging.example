# MANITEC GridOne API - staging/homologacao
# Nunca commite valores reais. Preencha no provedor de deploy/secret manager.
NODE_ENV="staging"
PORT="3000"
LOG_LEVEL="info"

# PostgreSQL exclusivo de staging
DATABASE_URL="postgresql://USER:PASSWORD@STAGING_HOST:5432/STAGING_DB?schema=public"
DB_NAME="STAGING_DB"
EXPECTED_DB_NAME="STAGING_DB"

# Auth/sessao - obrigatorio trocar por segredo forte no ambiente
JWT_SECRET="REPLACE_WITH_64_PLUS_RANDOM_CHARS"
MFA_ISSUER="MANITEC Operacao Integrada - Staging"
MFA_ENCRYPTION_KEY="REPLACE_WITH_32_PLUS_RANDOM_CHARS"

# CORS/rate limit
CORS_ORIGINS="https://erp-staging.suaempresa.com.br"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="300"

# URLs publicas de staging
APP_BASE_URL="https://erp-staging.suaempresa.com.br"
FRONTEND_BASE_URL="https://erp-staging.suaempresa.com.br"
FRONTEND_URL="https://erp-staging.suaempresa.com.br"

# Storage documental S3-compatible exclusivo de staging
FILE_STORAGE_DRIVER="s3"
S3_ENDPOINT="https://s3.REGIAO.amazonaws.com"
S3_BUCKET="REPLACE_WITH_STAGING_BUCKET"
S3_REGION="sa-east-1"
S3_ACCESS_KEY_ID="REPLACE_IN_SECRET_MANAGER"
S3_SECRET_ACCESS_KEY="REPLACE_IN_SECRET_MANAGER"
S3_FORCE_PATH_STYLE="false"

# Seeds de staging controlados. Nao usar dados pessoais reais.
SEED_ADMIN_EMAIL="admin-staging@suaempresa.com.br"
SEED_ADMIN_NAME="Administrador Staging"
SEED_ADMIN_PASSWORD="REPLACE_BEFORE_RUNNING_SEED"
SEED_MASTER_EMAIL="master-staging@suaempresa.com.br"
SEED_MASTER_NAME="MANITEC Staging"
SEED_MASTER_PASSWORD="REPLACE_BEFORE_RUNNING_SEED"
SEED_DEMO_PASSWORD="REPLACE_WITH_STAGING_ONLY_PASSWORD"

# Automacoes
AUTOMATION_ENABLED="true"
AUTOMATION_RUN_ON_BOOT="false"
AUTOMATION_TIMEZONE="America/Sao_Paulo"
AUTOMATION_DAILY_CRON="0 5 * * *"
AUTOMATION_HOURLY_ENABLED="true"
AUTOMATION_HOURLY_CRON="15 * * * *"
AUTOMATION_PREVENTIVE_DAYS_AHEAD="45"

# Entregas/e-mail/WhatsApp opcionais.
# Em staging, use sandbox ou desative envio real ate homologar.
DELIVERY_FROM_EMAIL="noreply-staging@suaempresa.com.br"
RESEND_API_KEY="REPLACE_IN_SECRET_MANAGER_OR_LEAVE_EMPTY"
RESEND_FROM_EMAIL="noreply-staging@suaempresa.com.br"
WHATSAPP_ACCESS_TOKEN="REPLACE_IN_SECRET_MANAGER_OR_LEAVE_EMPTY"
WHATSAPP_PHONE_NUMBER_ID="REPLACE_IN_SECRET_MANAGER_OR_LEAVE_EMPTY"
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v20.0"
DELIVERY_WEBHOOK_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Restore e operacoes sensiveis
ALLOW_DB_RESTORE="no"

# E2E remoto contra staging
E2E_DEMO_PASSWORD="REPLACE_WITH_STAGING_ONLY_PASSWORD"
E2E_TOTP_SECRET="REPLACE_WITH_STAGING_ONLY_TOTP"
E2E_API_URL="https://api-staging.suaempresa.com.br"
E2E_BASE_URL="https://erp-staging.suaempresa.com.br"
E2E_TARGET_ENV="staging"
E2E_USE_EXISTING_SERVER="true"
E2E_CONFIRM_STAGING="true"
E2E_STAGING_HOST_ALLOWLIST="api-staging.suaempresa.com.br,erp-staging.suaempresa.com.br"
E2E_RUNNER_TIMEOUT_MS="2700000"
E2E_PLAYWRIGHT_GLOBAL_TIMEOUT_MS="2670000"
E2E_SERVER_TIMEOUT_MS="180000"
E2E_MAX_FAILURES="1"
