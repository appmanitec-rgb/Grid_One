  status            BankReconciliationIssueStatus @default(OPEN)
  reason            String?
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?                         @relation("BankReconciliationIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([bankAccountId, status])
  @@index([statementImportId])
  @@index([statementEntryId])
  @@index([movementId])
  @@index([type, status])
  @@map("bank_reconciliation_issues")
}

