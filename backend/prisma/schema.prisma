  @@index([clientId, expiresAt])
  @@map("document_share_tokens")
}

model DocumentDelivery {
  id                String               @id @default(uuid())
  documentType      DeliveryDocumentType
  documentId        String
  documentCode      String?
  documentTitle     String?
  clientId          String?
  counterpartName   String?
  channel           DeliveryChannel
  status            DeliveryStatus       @default(PENDING)
  recipientName     String?
  recipientTarget   String
  subject           String?
  message           String?
  provider          String?
  providerMessageId String?
  shareTokenId      String?              @unique
  payloadSnapshot   Json?
  fileStorageKey    String?              @unique
  fileName          String?
  mimeType          String?
  sizeBytes         Int?
  checksumSha256    String?
  storedAt          DateTime?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  expiresAt         DateTime?
  createdByUserId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  client                 Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser          User?                 @relation("DocumentDeliveryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  shareToken             DocumentShareToken?   @relation(fields: [shareTokenId], references: [id], onDelete: SetNull)
  generatedServiceReport ServiceReport?        @relation("ServiceReportGeneratedDocument")
  generatedReportVersion ServiceReportVersion? @relation("ServiceReportVersionDocument")
  accessLogs             DocumentAccessLog[]

  @@index([documentType, documentId])
  @@index([clientId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([checksumSha256])
  @@index([status, createdAt])
  @@map("document_deliveries")
}

model DocumentAccessLog {
  id                 String                @id @default(uuid())
  documentType       DeliveryDocumentType
  documentId         String?
  documentDeliveryId String?
  serviceReportId    String?
  evidenceId         String?
  userId             String?
  clientId           String?
  shareLinkId        String?
  accessType         DocumentAccessType
  channel            DocumentAccessChannel
  result             DocumentAccessResult
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime              @default(now())

  documentDelivery DocumentDelivery?       @relation(fields: [documentDeliveryId], references: [id], onDelete: SetNull)
  serviceReport    ServiceReport?          @relation(fields: [serviceReportId], references: [id], onDelete: SetNull)
  evidence         ServiceReportEvidence?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  user             User?                   @relation("DocumentAccessLogActor", fields: [userId], references: [id], onDelete: SetNull)
  client           Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  shareLink        ServiceReportShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([documentType, documentId, createdAt])
  @@index([serviceReportId, createdAt])
  @@index([documentDeliveryId, createdAt])
  @@index([evidenceId, createdAt])
  @@index([userId, createdAt])
  @@index([clientId, createdAt])
  @@index([shareLinkId, createdAt])
  @@index([accessType, result, createdAt])
  @@map("document_access_logs")
}
