model BankMovement {
  id                      String                     @id @default(uuid())
  bankAccountId           String
  bankAccount             BankAccount                @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  type                    BankMovementType
  amount                  Float
  movementDate            DateTime
  competenceDate          DateTime?
  description             String
  originType              BankMovementOriginType
  originId                String
  receivableId            String?
  receivable              AccountsReceivable?        @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  payableId               String?
  payable                 AccountsPayable?           @relation(fields: [payableId], references: [id], onDelete: SetNull)
  receivablePaymentId     String?
  receivablePayment       AccountsReceivablePayment? @relation("ReceivablePaymentBankMovements", fields: [receivablePaymentId], references: [id], onDelete: SetNull)
  payablePaymentId        String?
  payablePayment          AccountsPayablePayment?    @relation("PayablePaymentBankMovements", fields: [payablePaymentId], references: [id], onDelete: SetNull)
  reversalOfMovementId    String?                    @unique
  reversalOfMovement      BankMovement?              @relation("BankMovementReversal", fields: [reversalOfMovementId], references: [id], onDelete: SetNull)
  reversedByMovement      BankMovement?              @relation("BankMovementReversal")
  status                  BankMovementStatus         @default(POSTED)
  createdById             String?
  createdBy               User?                      @relation("BankMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reconciledAt            DateTime?
  reconciledById          String?
  reconciledBy            User?                      @relation("BankMovementReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)
  reconciliationReference String?
  reconciliationNote      String?
  metadata                Json?
  createdAt               DateTime                   @default(now())
  statementEntries        BankStatementEntry[]       @relation("StatementEntryMatchedMovement")
  reconciliationIssues    BankReconciliationIssue[]

  @@unique([originType, originId])
  @@index([bankAccountId, movementDate])
  @@index([type, movementDate])
  @@index([originType, originId])
  @@index([receivableId])
  @@index([payableId])
  @@index([status, movementDate])
  @@map("bank_movements")
}

model BankStatementImport {
