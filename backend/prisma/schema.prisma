model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  UserRole               @default(TECHNICIAN)
  isActive              Boolean                @default(true)
  isSystemMaster        Boolean                @default(false)
  accessPolicy          Json?
  functionalId          String?
  documentId            String?
  profilePhotoUrl       String?
  managerId             String?
  linkedClientId        String?
  availabilityStatus    UserAvailabilityStatus @default(AVAILABLE)
  availabilityUpdatedAt DateTime?
  skillLevel            SkillLevel             @default(JUNIOR)
  regionTags            String[]
  digitalSignatureUrl   String?
  salesTargetMonthly    Float?
  kpiTargetJson         Json?
  mfaEnabled            Boolean                @default(false)
  mfaSecretEncrypted    String?
  mfaRecoveryCodesHash  Json?
  department            String?
  branch                String?
  approvalDiscountLimit Float?
  hourCost              Float?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  technicianProfile              Technician?
  manager                        User?                       @relation("UserManagementHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers                   User[]                      @relation("UserManagementHierarchy")
  linkedClient                   Client?                     @relation("ClientPortalUsers", fields: [linkedClientId], references: [id], onDelete: SetNull)
  proposals                      Proposal[]
  customerProposalDecisions      Proposal[]                  @relation("ProposalCustomerDecisionBy")
  proposalMovements              ProposalMovement[]
  presences                      UserPresence[]
  certifications                 UserCertification[]
  manufacturerSpecialties        UserManufacturerSpecialty[]
  requestedApprovals             ApprovalRequest[]           @relation("ApprovalRequester")
  approvalQueue                  ApprovalRequest[]           @relation("ApprovalApprover")
  systemAuditLogs                SystemAuditLog[]            @relation("SystemAuditActor")
  clientAuditLogs                ClientAuditLog[]
  createdGenerators              Generator[]                 @relation("GeneratorCreatedBy")
  managedClients                 Client[]                    @relation("ClientSalesOwner")
  createdContracts               ServiceContract[]           @relation("ContractCreatedBy")
  assignedOpportunities          SalesOpportunity[]          @relation("OpportunityAssignedSeller")
  commercialInspections          CommercialInspection[]      @relation("InspectionInspector")
  companySettingsUpdated         CompanySettings[]           @relation("CompanySettingsUpdatedBy")
  financialAuditLogs             FinancialAuditLog[]         @relation("FinancialAuditActor")
  receivablePayments             AccountsReceivablePayment[] @relation("ReceivablePaymentActor")
  reversedReceivablePayments     AccountsReceivablePayment[] @relation("ReceivablePaymentReversedBy")
  payablePayments                AccountsPayablePayment[]    @relation("PayablePaymentActor")
  reversedPayablePayments        AccountsPayablePayment[]    @relation("PayablePaymentReversedBy")
  createdBankMovements           BankMovement[]              @relation("BankMovementCreatedBy")
  reconciledBankMovements        BankMovement[]              @relation("BankMovementReconciledBy")
  importedBankStatements         BankStatementImport[]       @relation("BankStatementImportedBy")
  resolvedReconciliationIssues   BankReconciliationIssue[]   @relation("BankReconciliationIssueResolvedBy")
  closedFinancialPeriods         FinancialPeriodClosing[]    @relation("FinancialPeriodClosedBy")
  reopenedFinancialPeriods       FinancialPeriodClosing[]    @relation("FinancialPeriodReopenedBy")
  timeEntries                    TimeEntry[]
  commissions                    CommissionEntry[]
  commissionRules                CommissionRule[]            @relation("CommissionRuleSeller")
  hrAssetAssignments             HrAssetAssignment[]
  fleetAllocations               FleetAllocation[]
  authSessions                   AuthSession[]
  requestedAutomationRuns        AutomationRun[]             @relation("AutomationRunRequestedBy")
  createdDocumentShareTokens     DocumentShareToken[]        @relation("DocumentShareCreatedBy")
  createdDocumentDeliveries      DocumentDelivery[]          @relation("DocumentDeliveryCreatedBy")
  openedTickets                  ServiceTicket[]             @relation("TicketOpenedBy")
  assignedTickets                ServiceTicket[]             @relation("TicketAssignedTo")
  ticketComments                 ServiceTicketComment[]      @relation("TicketCommentAuthor")
  technicianWorkSessions         TechnicianWorkSession[]     @relation("TechnicianWorkSessionUser")
  createdServiceReports          ServiceReport[]             @relation("ServiceReportCreatedBy")
  updatedServiceReports          ServiceReport[]             @relation("ServiceReportUpdatedBy")
  releasedServiceReports         ServiceReport[]             @relation("ServiceReportReleasedBy")
  revokedServiceReports          ServiceReport[]             @relation("ServiceReportRevokedBy")
  archivedServiceReports         ServiceReport[]             @relation("ServiceReportArchivedBy")
  customerAcceptedServiceReports ServiceReport[]             @relation("ServiceReportCustomerAcceptedBy")
  uploadedReportEvidences        ServiceReportEvidence[]     @relation("ServiceReportEvidenceUploadedBy")
  createdServiceReportVersions   ServiceReportVersion[]      @relation("ServiceReportVersionCreatedBy")
  createdServiceReportShareLinks ServiceReportShareLink[]    @relation("ServiceReportShareLinkCreatedBy")
  documentAccessLogs             DocumentAccessLog[]         @relation("DocumentAccessLogActor")

  @@index([linkedClientId])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String
  deviceName       String?
  refreshTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, deviceId])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model AutomationRun {
  id                String              @id @default(uuid())
  mode              AutomationRunMode
  trigger           String
  status            AutomationRunStatus @default(RUNNING)
  requestedByUserId String?
  requestedByUser   User?               @relation("AutomationRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  startedAt         DateTime            @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  summary           Json?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, startedAt])
  @@index([mode, startedAt])
  @@index([requestedByUserId])
  @@map("automation_runs")
}

model UserPresence {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  speedKmh       Float?
  heading        Float?
  batteryLevel   Int?
  source         String?  @default("MOBILE")
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, recordedAt])
  @@index([recordedAt])
  @@map("user_presences")
}

model UserCertification {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  scope      UserCertificationScope @default(SAFETY)
  issuer     String?
  validUntil DateTime
  metadata   Json?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([userId, code, validUntil])
  @@map("user_certifications")
}

model UserManufacturerSpecialty {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  manufacturer String
  level        SkillLevel @default(JUNIOR)
  validUntil   DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, manufacturer])
  @@map("user_manufacturer_specialties")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  type            ApprovalType
  status          ApprovalStatus @default(PENDING)
  entityType      String
  entityId        String
  requesterUserId String
  requesterUser   User           @relation("ApprovalRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  approverUserId  String
  approverUser    User           @relation("ApprovalApprover", fields: [approverUserId], references: [id], onDelete: Cascade)
  requestNote     String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, approverUserId, createdAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model SystemAuditLog {
  id            String      @id @default(uuid())
  domain        AuditDomain
  entityType    String
  entityId      String
  action        String
  actorUserId   String?
  actorUser     User?       @relation("SystemAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  beforePayload Json?
  afterPayload  Json?
  reason        String?
  createdAt     DateTime    @default(now())

  @@index([domain, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("system_audit_logs")
}

model CompanySettings {
  id                        String   @id @default(uuid())
  key                       String   @unique @default("default")
  companyName               String?
  tradeName                 String?
  cnpj                      String?
  stateRegistration         String?
  municipalRegistration     String?
  taxRegime                 String?
  contactName               String?
  contactRole               String?
  phone                     String?
  whatsapp                  String?
  email                     String?
  billingEmail              String?
  website                   String?
  address                   String?
  addressNumber             String?
  addressComplement         String?
  district                  String?
  city                      String?
  state                     String?
  zipCode                   String?
  country                   String?
  logoUrl                   String?
  primaryColor              String?
  secondaryColor            String?
  deliverySenderName        String?
  deliveryFromEmail         String?
  deliveryReplyToEmail      String?
  deliveryDefaultWhatsapp   String?
  deliveryDefaultWebhookUrl String?
  deliveryEmailFooter       String?
  deliveryTemplatesJson     Json?
  notes                     String?
  isPrimary                 Boolean  @default(false)
  updatedByUserId           String?
  updatedByUser             User?    @relation("CompanySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([cnpj])
  @@index([isPrimary])
  @@map("company_settings")
}

model Technician {
  id     String   @id @default(uuid())
  cpf    String   @unique
  phone  String
  skills String[]

  latitude  Float?
  longitude Float?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orders         MaintenanceOrder[]
  certifications TechnicianCertification[]
  serviceTickets ServiceTicket[]
  serviceReports ServiceReport[]
  workSessions   TechnicianWorkSession[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  warehouses Warehouse[]

  @@map("technicians")
}

model Client {
  id                    String           @id @default(uuid())
  companyName           String
  tradeName             String?
  cnpj                  String           @unique
  email                 String?
  contactName           String?
  phone                 String
  address               String?
  city                  String
  state                 String
  stateRegistration     String?
  municipalRegistration String?
  cnae                  String?
  preferences           String?
  segment               String?
  clientType            ClientType       @default(NO_CONTRACT)
  personType            ClientPersonType @default(LEGAL_ENTITY)
  paymentTermDefault    String?
  creditLimit           Float?
  priceTableCode        String?
  isDelinquent          Boolean          @default(false)
  withholdsInss         Boolean          @default(false)
  withholdsIss          Boolean          @default(false)
  salesOwnerId          String?

  salesOwner  User?  @relation("ClientSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  portalUsers User[] @relation("ClientPortalUsers")

  addresses             ClientAddress[]
  contacts              ClientContact[]
  auditLogs             ClientAuditLog[]
  proposals             Proposal[]
  opportunities         SalesOpportunity[]
  commercialInspections CommercialInspection[]
  sites                 Site[]
  generators            Generator[]
  contracts             ServiceContract[]
  accountsReceivable    AccountsReceivable[]
  costCenters           CostCenter[]
  documentShareTokens   DocumentShareToken[]
  documentDeliveries    DocumentDelivery[]
  serviceTickets        ServiceTicket[]
  serviceReports        ServiceReport[]
  documentAccessLogs    DocumentAccessLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model ClientAddress {
  id         String            @id @default(uuid())
  type       ClientAddressType
  street     String
  number     String?
  complement String?
  district   String?
  zipCode    String?
  city       String
  state      String
  country    String?           @default("BR")

  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunities         SalesOpportunity[]
  commercialInspections CommercialInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_addresses")
}

model ClientContact {
  id     String              @id @default(uuid())
  name   String
  status ClientContactStatus @default(ACTIVE)
  role   String?
  phone  String?
  mobile String?
  email  String?

  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunities         SalesOpportunity[]
  commercialInspections CommercialInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_contacts")
}

model GeneratorModel {
  id    String  @id @default(uuid())
  name  String  @unique
  brand String?

  suggestedItems         CatalogItem[]           @relation("ModelSuggestedItems")
  baseItems              ModelBaseItem[]
  category               String?
  defaultPowerKva        Float?
  defaultPowerKw         Float?
  defaultVoltage         String?
  controllerType         String?
  engineModel            String?
  alternatorModel        String?
  defaultFuelConsumption String?
  defaultTankCapacity    String?
  maintenancePlan        Json?
  manuals                GeneratorManual[]
  serviceReportTemplates ServiceReportTemplate[]

  generators Generator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modelos")
}

model Generator {
  id                     String                     @id @default(uuid())
  name                   String
  brand                  String
  serialNumber           String?                    @unique
  power                  Float
  hourMeter              Int?
  condition              String?                    @default("BOM")
  assetTag               String?
  qrCode                 String?
  installationSite       String?
  operationalStatus      GeneratorOperationalStatus @default(OPERATING)
  lifecycleStatus        GeneratorLifecycleStatus   @default(AVAILABLE)
  criticality            GeneratorCriticality       @default(B)
  manufactureYear        Int?
  installationDate       DateTime?
  warrantyEndDate        DateTime?
  hasMaintenanceContract Boolean                    @default(false)
  createdByUserId        String?

  modelId       String?
  model         GeneratorModel? @relation(fields: [modelId], references: [id])
  currentSiteId String?
  currentSite   Site?           @relation(fields: [currentSiteId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("GeneratorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  proposals         Proposal[]
  clientId          String
  client            Client                       @relation(fields: [clientId], references: [id])
  orders            MaintenanceOrder[]
  serviceTickets    ServiceTicket[]
  serviceReports    ServiceReport[]
  telemetryEvents   TelemetryEvent[]
  baseItems         GeneratorBaseItem[]
  contractLinks     ContractEquipment[]
  contractSchedules ContractPreventiveSchedule[]
  costCenter        CostCenter?                  @relation("GeneratorCostCenter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("generators")
}

model ClientAuditLog {
  id          String   @id @default(uuid())
  action      String
  details     String?
  payload     Json?
  clientId    String
  actorUserId String?
  createdAt   DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("client_audit_logs")
}

model CatalogItem {
  id                     String         @id @default(uuid())
  sku                    String?        @unique
  name                   String
  description            String?
  commercialDescription  String?
  category               String?
  subcategory            String?
  type                   ItemType
  unit                   String?        @default("UN")
  manufacturerPartNumber String?
  brand                  String?
  supplier               String?
  technicalSpecs         Json?
  applicationNotes       String?
  ncm                    String?
  cest                   String?
  origin                 ProductOrigin?
  costPrice              Float?         @default(0)
  averageCost            Float?         @default(0)
  lastCost               Float?         @default(0)
  taxPercentage          Float?         @default(0)
  profitMargin           Float?         @default(0)
